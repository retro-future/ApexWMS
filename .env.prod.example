# Copy to .env.prod and edit. Used by docker-compose.prod.yml.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Postgres (the master database lives here; tenant DBs are created next to it) ---
# Use only letters and digits in the password: it goes into a database URL.
POSTGRES_USER=apexwms
POSTGRES_PASSWORD=changeMeStrongPassword
POSTGRES_DB=apexwms_master

# --- Backend ---
# The backend DB URL is built from POSTGRES_* above by docker-compose.prod.yml.
# Generate the JWT secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APEXWMS_JWT_SECRET=change-me-generate-a-random-secret
APEXWMS_DEBUG=false
WEB_CONCURRENCY=2

# --- Frontend ---
# Server-to-server URL to the backend container. No NEXT_PUBLIC_ prefix on purpose.
APEX_API_URL=http://backend:8000/api/v1
# Where the frontend port is published. Local test: 127.0.0.1:3000
# Own nginx on the host: 127.0.0.1:3000 and proxy to it.
FRONTEND_PORT=127.0.0.1:3000

# --- Caddy (only with `--profile edge`) ---
CADDY_DOMAIN=wms.example.com
CADDY_EMAIL=you@example.com
