APEXWMS_DEBUG=true
APEXWMS_MASTER_DB_URL=postgresql+asyncpg://apexwms:apexwms@localhost:5432/apexwms_master
APEXWMS_JWT_SECRET=dev-only-change-me

# Optional but needed for Russian documents. Without a Unicode TTF, printed
# documents use fpdf2's built-in Helvetica, which covers Latin-1 (enough for
# Uzbek Latin) but not Cyrillic, which degrades to '?'. A DejaVu Sans TTF
# ships in the repo:
# APEXWMS_PDF_FONT_PATH=src/infrastructure/documents/fonts/DejaVuSans.ttf
