APEXWMS_DEBUG=true
APEXWMS_MASTER_DB_URL=postgresql+asyncpg://apexwms:apexwms@localhost:5432/apexwms_master
APEXWMS_JWT_SECRET=dev-only-change-me

# Printed documents use the bundled DejaVu Sans by default, which covers
# Cyrillic. Point this at another Unicode TTF to override it, or set it
# empty to force fpdf2's built-in Helvetica (Latin-1 only).
# APEXWMS_PDF_FONT_PATH=

# Logging: level for both console and file sinks, and the directory rotated
# daily JSON log files are written to (kept for 7 days).
# APEXWMS_LOG_LEVEL=INFO
# APEXWMS_LOG_DIR=logs
